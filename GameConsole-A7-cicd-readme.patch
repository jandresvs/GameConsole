diff -ruN orig/GameConsole-main/.github/workflows/release.yml GameConsole-main/.github/workflows/release.yml
--- orig/GameConsole-main/.github/workflows/release.yml	1970-01-01 00:00:00.000000000 +0000
+++ GameConsole-main/.github/workflows/release.yml	2026-11-20 19:30:40.231026051 +0000
@@ -0,0 +1,104 @@
+# Entrega (CD): al publicar un release en GitHub (por ejemplo v1.0):
+#   1. verifica: levanta el sistema completo y corre la prueba de humo;
+#   2. publica las imágenes propias (consola y Prolog) en ghcr.io con la versión
+#      del release como etiqueta;
+#   3. adjunta al release gameconsole-images.tar.gz, con las CUATRO imágenes
+#      (incluidas las de GameStats), para quien prefiera cargarlas sin registro:
+#         docker load -i gameconsole-images.tar.gz && docker compose up -d --no-build
+#
+# No hace falta configurar secretos: GitHub da un GITHUB_TOKEN temporal con
+# permiso para publicar paquetes y adjuntar archivos al release.
+name: Release
+on:
+  release:
+    types: [published]
+  workflow_dispatch:
+
+permissions:
+  contents: write       # adjuntar el .tar.gz al release
+  packages: write       # subir imágenes a ghcr.io
+
+jobs:
+  verify:
+    name: Verificar el sistema completo
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - run: docker compose up -d --build --wait
+      - run: bash scripts/smoke-test.sh
+      - name: Mostrar logs si algo falló
+        if: failure()
+        run: docker compose logs
+      - if: always()
+        run: docker compose down
+
+  publish:
+    name: Publicar imágenes
+    needs: verify
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Calcular nombres de las imágenes
+        # ghcr.io exige minúsculas. La versión es el tag del release (v1.0);
+        # si se lanza a mano, el nombre de la rama.
+        run: |
+          echo "REGISTRY=ghcr.io/${GITHUB_REPOSITORY_OWNER,,}" >> "$GITHUB_ENV"
+          echo "VERSION=${GITHUB_REF_NAME}" >> "$GITHUB_ENV"
+
+      - uses: docker/login-action@v3
+        with:
+          registry: ghcr.io
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+
+      - uses: docker/setup-buildx-action@v3
+
+      - name: Imagen de la consola (nginx + TypeScript compilado)
+        uses: docker/build-push-action@v6
+        with:
+          context: console-web
+          push: true
+          tags: |
+            ${{ env.REGISTRY }}/gameconsole-web:${{ env.VERSION }}
+            ${{ env.REGISTRY }}/gameconsole-web:latest
+          labels: org.opencontainers.image.source=${{ github.server_url }}/${{ github.repository }}
+
+      - name: Imagen de Prolog
+        uses: docker/build-push-action@v6
+        with:
+          context: ai-prolog
+          push: true
+          tags: |
+            ${{ env.REGISTRY }}/gameconsole-prolog:${{ env.VERSION }}
+            ${{ env.REGISTRY }}/gameconsole-prolog:latest
+          labels: org.opencontainers.image.source=${{ github.server_url }}/${{ github.repository }}
+
+      - name: Resumen
+        run: |
+          {
+            echo "### Imágenes publicadas"
+            echo "- \`${REGISTRY}/gameconsole-web:${VERSION}\`"
+            echo "- \`${REGISTRY}/gameconsole-prolog:${VERSION}\`"
+            echo
+            echo "Recuerda: en GitHub → Packages, cada imagen debe quedar en **Public** para descargarla sin iniciar sesión."
+          } >> "$GITHUB_STEP_SUMMARY"
+
+  bundle:
+    name: Empaquetar imágenes para entrega sin registro
+    needs: verify
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - run: bash scripts/export-images.sh gameconsole-images.tar.gz
+      - name: Adjuntar al release
+        if: github.event_name == 'release'
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: gh release upload "${{ github.event.release.tag_name }}" gameconsole-images.tar.gz --clobber
+      - name: Guardar como artefacto (lanzamiento manual)
+        if: github.event_name != 'release'
+        uses: actions/upload-artifact@v4
+        with:
+          name: gameconsole-images
+          path: gameconsole-images.tar.gz
